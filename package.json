{
  "name": "noctura-invoice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:core": "node --experimental-strip-types --test packages/invoice-core/tests/*.test.ts",
    "test:api": "node --experimental-strip-types --test apps/license-api/tests/*.test.ts",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "desktop:dev": "npm run tauri:dev --workspace @noctura/desktop",
    "server:up": "docker compose up -d",
    "server:logs": "docker compose logs -f license-api",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:ui": "vitest run --root apps/desktop"
  }
}
