# Noctura Lizenzserver — Beispielkonfiguration
# Kopieren nach .env und alle Werte ersetzen. Die Datei .env gehoert nicht ins Repository.
#
# Zufallswerte erzeugen:
#   openssl rand -base64 48
#
# Ausnahme: POSTGRES_PASSWORD, siehe Hinweis dort.

# --- PostgreSQL ---
POSTGRES_USER=noctura
# WICHTIG: hier keinen Wert mit "openssl rand -base64" verwenden. base64
# kann / + = enthalten; diese Zeichen landen unveraendert (ohne
# URL-Kodierung) in DATABASE_URL weiter unten in docker-compose.yml und
# koennen die Verbindungs-URL zerlegen - Prisma meldet das als
# "P1013: invalid port number", was in die falsche Richtung fuehrt, wenn
# man nicht weiss, dass eigentlich das Passwort die Ursache ist.
# hex ist immer URL-sicher, keine Ausnahme, kein Escaping noetig:
#   openssl rand -hex 32
POSTGRES_PASSWORD=HIER_EIN_LANGES_ZUFALLSPASSWORT_MIT_OPENSSL_RAND_HEX_32
POSTGRES_DB=noctura

# --- Geheimnisse der API ---
# Diese beiden landen nie in einer URL, "openssl rand -base64 48" ist hier unproblematisch.
# Pepper fuer den HMAC ueber Lizenzschluessel. Aenderung macht alle bestehenden
# Lizenzschluessel unauffindbar — nur bei einer geplanten Migration aendern.
LICENSE_KEY_PEPPER=HIER_MINDESTENS_32_ZEICHEN_ZUFALL
# Pepper fuer die Pseudonymisierung von IP-Adressen im Aktivierungsprotokoll.
IP_HASH_PEPPER=HIER_EIN_WEITERER_ZUFALLSWERT

# --- Betrieb ---
PUBLIC_BASE_URL=https://rechnungsapp.jadenk.de
LOG_LEVEL=info

# Nicht hier eintragen:
#   Signaturschluessel und Admin-Access-Token erzeugt der Container beim ersten
#   Start selbst und legt sie unter /data/secrets ab (Volume license-secrets).
#   Der Admin-Token erscheint genau einmal im Startlog.
