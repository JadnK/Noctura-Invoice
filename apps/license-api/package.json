{
  "name": "@noctura/license-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node --experimental-strip-types prisma/seed.ts",
    "admin-token:rotate": "node --experimental-strip-types scripts/rotate-admin-token.ts",
    "keys:generate": "node --experimental-strip-types scripts/generate-signing-key.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/csrf-protection": "^6.4.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.20.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.2"
  }
}
