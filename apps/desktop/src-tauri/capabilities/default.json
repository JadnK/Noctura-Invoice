{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimalrechte. Jede zusaetzliche Berechtigung braucht eine Begruendung im Pull Request.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/noctura/**" }, { "path": "$DOCUMENT/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/noctura/**" }, { "path": "$DOCUMENT/Noctura/**" }]
    },
    "os:allow-os-type",
    "process:allow-restart",
    "updater:default"
  ]
}
